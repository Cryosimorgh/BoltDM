{
  "manifest_version": 3,
  "name": "BoltDM Companion",
  "version": "1.2.0",
  "description": "Capture browser downloads into BoltDM (opt-in), or collect matching links on a page.",
  "minimum_chrome_version": "121",
  "permissions": [
    "activeTab",
    "scripting",
    "cookies",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:17654/*"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "scripts": [
      "service_worker.js"
    ]
  },
  "action": {
    "default_title": "BoltDM",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "boltdm-companion@cryosimorgh.github.io",
      "strict_min_version": "121.0"
    }
  }
}
